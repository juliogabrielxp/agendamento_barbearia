# Copie para /etc/agendamento/backup.env (dono root, chmod 600).
# Sem senha aqui: as duas senhas ficam no SSM Parameter Store como SecureString.

# Banco de produção (o mesmo DB_HOST/DB_DATABASE do .env do app)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=agendamento

# Usuário só de leitura que faz o dump
BACKUP_DB_USER=backup
BACKUP_DB_PASSWORD_SSM=/agendamento/backup/db-password-backup

# Destino fora do servidor. Retenção (7 diárias, 4 semanais) fica no ciclo de vida do bucket.
BACKUP_S3_URI=s3://NOME-DO-BUCKET/agendamento
# 1 = segunda ... 7 = domingo
BACKUP_DIA_SEMANAL=7

# Teste de restauração: banco SEPARADO e usuário que só tem permissão nele
RESTORE_DB_NAME=agendamento_restauracao_teste
RESTORE_DB_USER=restauracao
RESTORE_DB_PASSWORD_SSM=/agendamento/backup/db-password-restauracao

# Região do bucket e do SSM: a mesma da EC2 (São Paulo)
AWS_DEFAULT_REGION=sa-east-1

# Opcional: URL que recebe um GET quando dá certo (ex.: healthchecks.io). O serviço
# avisa você quando o GET NÃO chega, que é justamente o dia em que o backup parou.
#BACKUP_PING_URL=
#RESTORE_PING_URL=
