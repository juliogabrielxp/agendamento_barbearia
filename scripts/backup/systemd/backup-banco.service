[Unit]
Description=Backup do MySQL do agendamento-barbearia para o S3
Wants=network-online.target
After=network-online.target mysql.service

[Service]
Type=oneshot
EnvironmentFile=/etc/agendamento-barbearia/backup.env
ExecStart=/usr/local/lib/agendamento-backup/backup-banco.sh
# Roda com um usuário descartável, sem acesso de escrita ao sistema
DynamicUser=yes
Environment=HOME=/tmp
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
